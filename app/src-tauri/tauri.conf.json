{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Papagun",
  "version": "0.1.0",
  "identifier": "kz.papagun.desktop",
  "build": { "beforeDevCommand": "npm.cmd run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm.cmd run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "Papagun", "width": 1340, "height": 860, "minWidth": 820, "minHeight": 620, "backgroundColor": "#f5f7fa" }], "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost" } },
  "bundle": { "active": true, "targets": ["nsis"], "externalBin": ["binaries/papagun-engine"], "windows": { "webviewInstallMode": { "type": "offlineInstaller" } } }
}
